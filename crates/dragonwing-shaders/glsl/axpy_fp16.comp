#version 450
//
// axpy_fp16 — y[i] = a * x[i] + y[i], with F16 inputs/outputs.
//
// The computation is done in F32 to avoid overflow during the multiply-add,
// then converted back to F16 on store. This is the standard "mixed precision"
// pattern for F16 activations.
//
// Extensions required:
//   GL_EXT_shader_16bit_storage       — for float16_t SSBO load/store
//   GL_EXT_shader_explicit_arithmetic_types_float16 — for float16_t type
//
// Bindings:
//   set=0 binding=0  std430 buffer Y[]   (read+write, float16_t)
//   set=0 binding=1  std430 buffer X[]   (read-only, float16_t)
//
// Push constants (16 bytes):
//   uint  n         — element count
//   float a         — scalar multiplier (f32, to avoid precision loss)
//   float _pad0
//   float _pad1
//
// Dispatch:
//   gx = ceil(n / 64). gy = gz = 1.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer YBuf {
    float16_t y[];
};

layout(set = 0, binding = 1, std430) readonly buffer XBuf {
    float16_t x[];
};

layout(push_constant) uniform Pc {
    uint  n;
    float a;
    float _pad0;
    float _pad1;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.n) {
        return;
    }
    // Load as F16, widen to F32 for computation
    float x_f32 = float(x[gid]);
    float y_f32 = float(y[gid]);
    // FMA in F32 precision
    float result = fma(pc.a, x_f32, y_f32);
    // Convert back to F16 on store
    y[gid] = float16_t(result);
}
