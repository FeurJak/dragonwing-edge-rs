#version 450
//
// add_f32 — element-wise addition: y[i] = a[i] + b[i].
//
// Bindings:
//   set=0 binding=0  std430 buffer Y[]   (write-only, output)
//   set=0 binding=1  std430 buffer A[]   (read-only, input)
//   set=0 binding=2  std430 buffer B[]   (read-only, input)
//
// Push constants (16 bytes):
//   uint  n         — element count
//   uint  _pad0
//   uint  _pad1
//   uint  _pad2
//
// Dispatch:
//   gx = ceil(n / 64). gy = gz = 1.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) writeonly buffer YBuf {
    float y[];
};

layout(set = 0, binding = 1, std430) readonly buffer ABuf {
    float a[];
};

layout(set = 0, binding = 2, std430) readonly buffer BBuf {
    float b[];
};

layout(push_constant) uniform Pc {
    uint  n;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.n) {
        return;
    }
    y[gid] = a[gid] + b[gid];
}
